APP_NAME="Portfolio Tracker"
APP_URL=http://localhost
APP_ENV=local
APP_DEBUG=true
APP_KEY=

# Set to * when running behind a reverse proxy (nginx, Traefik, etc.) to trust X-Forwarded-Proto
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_STACK=single,stderr
LOG_LEVEL=debug

DB_ROOT_PASSWORD=root
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret

FINNHUB_API_KEY=your_finnhub_api_key_here
